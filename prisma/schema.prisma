generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  LOCKED
  PUBLISHED
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Blog {
  id           Int           @id @default(autoincrement())
  title        String
  slug         String        @unique
  excerpt      String?
  content      String
  thumbnailUrl String?
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   BlogCategoryOnBlog[]
  tags         BlogTagOnBlog[]
}

model BlogCategory {
  id        Int                  @id @default(autoincrement())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  blogs     BlogCategoryOnBlog[]
}

model BlogTag {
  id        Int             @id @default(autoincrement())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  blogs     BlogTagOnBlog[]
}

model BlogCategoryOnBlog {
  blogId     Int
  categoryId Int
  blog       Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogId, categoryId])
}

model BlogTagOnBlog {
  blogId Int
  tagId  Int
  blog   Blog    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    BlogTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model Novel {
  id         Int           @id @default(autoincrement())
  title      String
  slug       String        @unique
  summary    String
  genre      String?
  coverUrl   String?
  musicTitle String?
  musicArtist String?
  musicUrl   String?
  musicVolume Int      @default(35)
  status     PublishStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  chapters   Chapter[]
}

model Chapter {
  id           Int           @id @default(autoincrement())
  novelId      Int
  novel        Novel         @relation(fields: [novelId], references: [id], onDelete: Cascade)
  title        String
  slug         String
  chapterNumber Int
  content      String
  thumbnailUrl String?
  musicTitle   String?
  musicArtist  String?
  musicUrl     String?
  musicVolume  Int      @default(35)
  status       PublishStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  slides       ChapterSlide[]

  @@unique([novelId, slug])
  @@unique([novelId, chapterNumber])
}

model ChapterSlide {
  id        Int      @id @default(autoincrement())
  chapterId Int
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  type      String   @default("text")
  imageUrl  String?
  title     String?
  content   String?
  caption   String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, order])
}
